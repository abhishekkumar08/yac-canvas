{
  "name": "yac-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n web,relay -c green,blue \"npm:web\" \"npm:relay\"",
    "web": "vite --config web/vite.config.js",
    "relay": "node server/relay.js",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "lint": "eslint web/src server test e2e",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@kasumi/ui": "file:../kasumi",
    "lucide-react": "^0.298.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "roughjs": "^4.6.6",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.15.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5"
  }
}
